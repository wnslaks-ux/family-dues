<script>
function copyText(t, btn){
  function done(){ if(btn){var o=btn.textContent;btn.textContent='복사됨 ✓';setTimeout(function(){btn.textContent=o;},1500);} }
  if(navigator.clipboard&&window.isSecureContext){navigator.clipboard.writeText(t).then(done,function(){fb();});}else fb();
  function fb(){var a=document.createElement('textarea');a.value=t;document.body.appendChild(a);a.select();try{document.execCommand('copy');done();}catch(e){prompt('복사해서 사용하세요',t);}document.body.removeChild(a);}
}
</script>
</body></html>
